{
  "name": "tessera",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise AI-native cyber-financial fusion intelligence platform.",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev:frontend": "pnpm --filter @tessera/frontend dev",
    "build:frontend": "pnpm --filter @tessera/frontend build",
    "lint:frontend": "pnpm --filter @tessera/frontend lint",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "pnpm lint:js && pnpm lint:python",
    "lint:js": "eslint .",
    "lint:python": "python -m ruff check .",
    "test": "echo \"No tests configured yet.\""
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "eslint": "^9.30.1",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.35.1"
  }
}
